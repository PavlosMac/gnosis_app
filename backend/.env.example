# Application
APP_NAME=gnosis_esoterica
APP_ENV=development
DEBUG=true

# MongoDB
# Use mongodb://localhost:27017 for local dev without Docker
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=gnosis_esoterica

# JWT — required, no default (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI — leave empty to use the free MockLLMAdapter; setting a key makes real
# (billed) API calls even on a dev machine.
OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5.4
#OPENAI_REASONING_EFFORT=medium

# Logging
#LOG_LEVEL=INFO
#LOG_JSON=false
