# Application
APP_NAME=gnosis_esoterica
APP_ENV=development
DEBUG=true

# MongoDB — required, no default. This is the compose Mongo as seen from the host
# (native runs, `make migrate`); the compose `api` service sets its own address.
MONGODB_URI=mongodb://localhost:27019
MONGODB_DATABASE=gnosis_esoterica

# JWT — required, no default (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI — leave empty to use the free MockLLMAdapter; setting a key makes real
# (billed) API calls even on a dev machine.
OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5.4
#OPENAI_REASONING_EFFORT=medium

# Email (Resend) — leave the key empty to use the console adapter, which logs the
# reset / verification link instead of sending (the link itself is only logged when
# APP_ENV=development; anywhere else it is redacted). Setting a key sends real email
# even on a dev machine.
# EMAIL_FROM must use a domain verified in the Resend dashboard (or use
# "onboarding@resend.dev" for a quick test).
RESEND_API_KEY=
#EMAIL_FROM=Tarot Divinations <noreply@tarotdivinations.com>

# Frontend — emailed links are {FRONTEND_BASE_URL}/reset-password?token=... and
# {FRONTEND_BASE_URL}/verify-email?token=...
#FRONTEND_BASE_URL=http://localhost:3000

# Password reset — if the TTL changes, update the expiry wording in
# src/notifications/templates.py to match.
#PASSWORD_RESET_TOKEN_TTL_MINUTES=30
#PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
#PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5

# Email verification — a new account cannot sign in until the emailed link is confirmed.
# Resend-verification throttling reuses the password-reset window/max above.
#EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# A never-verified account is purged this many days after registration or its last resend.
#PENDING_ACCOUNT_TTL_DAYS=7

# Rate limits — login is keyed by client IP + email, register by client IP.
#LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
#LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
#REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
#REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10
# The Next.js server forwards the browser's address in X-Forwarded-For. Set false if the
# API is ever exposed directly (a caller could otherwise choose its own throttle key).
#RATE_LIMIT_TRUST_FORWARDED_FOR=true

# Support contact form — POST /api/v1/support/contact relays the user's message to this
# inbox with Reply-To set to the user. This is a destination, not the From identity
# (that stays EMAIL_FROM). Leave empty and the endpoint answers 503.
SUPPORT_EMAIL=
#SUPPORT_CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
#SUPPORT_CONTACT_RATE_LIMIT_MAX_ATTEMPTS=5

# Logging
#LOG_LEVEL=INFO
#LOG_JSON=false

