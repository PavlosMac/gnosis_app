# Gnosis Esoterica — Production Environment (Raspberry Pi)
# Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod

# Application
APP_NAME=gnosis_esoterica
APP_ENV=production
DEBUG=false

# MongoDB (auth credentials must match mongo/init-user.js)
# The API connects as the scoped app user, NOT root.
MONGO_ROOT_PASSWORD=<openssl rand -hex 16>
GNOSIS_APP_PASSWORD=<openssl rand -hex 16>
MONGODB_URI=mongodb://gnosis_app:<GNOSIS_APP_PASSWORD>@gnosis-mongodb:27017/gnosis_esoterica?authSource=gnosis_esoterica
MONGODB_DATABASE=gnosis_esoterica

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=<openssl rand -hex 32>
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
