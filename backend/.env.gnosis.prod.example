# Gnosis Esoterica — Production Environment (Raspberry Pi)
# Copy to .env.gnosis.prod and fill in real values:
#   cp .env.gnosis.prod.example .env.gnosis.prod

# Application
APP_NAME=gnosis_esoterica
APP_ENV=production
DEBUG=false

# MongoDB (auth credentials must match mongo/init-user.js)
# The API connects as the scoped app user, NOT root.
MONGO_ROOT_PASSWORD=<openssl rand -hex 16>
GNOSIS_APP_PASSWORD=<openssl rand -hex 16>
MONGODB_URI=mongodb://gnosis_app:<GNOSIS_APP_PASSWORD>@gnosis-mongodb:27017/gnosis_esoterica?authSource=gnosis_esoterica
MONGODB_DATABASE=gnosis_esoterica

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=<openssl rand -hex 32>
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI — only models in Settings.model_price_table (gpt-5.4, gpt-5.4-mini) are
# priced; anything else is billed at the most expensive entry and logs a warning.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-5.4
OPENAI_MAX_TOKENS=10000
# Optional tunables (defaults shown — see src/core/config.py)
#OPENAI_REASONING_EFFORT=medium
#OPENAI_TIMEOUT_SECONDS=120.0
#OPENAI_MAX_RETRIES=2
#OPENAI_MAX_CONCURRENT=10
#OPENAI_ACQUIRE_TIMEOUT_SECONDS=30.0

# Reading length / budget (defaults shown)
#LLM_WORDS_PER_CARD=100
#SIGNIFICATOR_BUDGET_SCALE=1.5
#USER_BUDGET_USD=3.00

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
