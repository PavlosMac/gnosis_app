# Backend API base URL, server-side only (src/lib/api-client.ts, src/proxy.ts).
# Root `make dev` exports http://localhost:8001 and overrides this file.
# Only needed if you run `npm run dev` directly.
GNOSIS_API_BASE_URL=http://localhost:8001

# Must be exactly "true" to enable sign-up (src/lib/feature-flags.ts).
REGISTRATION_ENABLED=true
